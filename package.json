{
  "name": "student-registry-render",
  "version": "1.0.0",
  "private": true,
  "description": "Student registration web application with MongoDB, Jenkins, Terraform and Render deployment.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=junit --test-reporter-destination=reports/junit.xml",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "supertest": "^7.1.4"
  }
}
